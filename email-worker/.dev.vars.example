# Copy to .dev.vars for `npm run dev:worker`.
SETUP_TOKEN=replace-with-a-long-random-value
SUPER_ADMIN_EMAIL=owner@example.com
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
APP_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
APP_NAME=OmniMail

# Optional. Register the callback URL /api/auth/linux-do/callback in Linux DO Connect.
LINUX_DO_CLIENT_ID=
LINUX_DO_CLIENT_SECRET=

# Optional outbound providers. Add one entry per Resend sender domain.
RESEND_DOMAIN_CONFIGS={"example.com":{"apiKey":"re_example"}}
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRETS=["whsec_account_one","whsec_account_two"]

# A matching SendFlare domain entry takes precedence over Resend for that domain.
# SENDFLARE_FROM must be a verified sender email address, without a display name.
SENDFLARE_API_KEY=
SENDFLARE_FROM=
SENDFLARE_DOMAIN_CONFIGS={"sendflare.example":{"apiKey":"sf_example","from":"mail@sendflare.example"}}

# At least 32 random characters. Encrypts administrator TOTP secrets in D1.
TOTP_ENCRYPTION_KEY=

# 可选：所有外部邮箱共用一个至少 32 个随机 UTF-8 字节的 Secret。
MAIL_CREDENTIALS_KEY=
# 旧部署继续支持以下独立密钥；迁移完成前保留原值。
# ICLOUD_CREDENTIALS_KEY=
# LINUX_DO_MAIL_CREDENTIALS_KEY=
# GMAIL_CREDENTIALS_KEY=
# QQ_MAIL_CREDENTIALS_KEY=
# NAVER_MAIL_CREDENTIALS_KEY=
# MICROSOFT_CREDENTIALS_KEY=
# YANDEX_MAIL_CREDENTIALS_KEY=
MICROSOFT_MAIL_ENABLED=true
NAVER_MAIL_IMAP_ENABLED=false
YANDEX_MAIL_IMAP_ENABLED=false
