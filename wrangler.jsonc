{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni-mail",
  "main": "./email-worker/src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "REALTIME_UPDATES", "class_name": "RealtimeUpdates" }]
  },
  "migrations": [{ "tag": "realtime-v1", "new_sqlite_classes": ["RealtimeUpdates"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "omni-mail-backups"
    }
  ],
  "workflows": [
    {
      "name": "omni-mail-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "OmniMailBackupWorkflow"
    },
    {
      "name": "omni-mail-cleanup",
      "binding": "CLEANUP_WORKFLOW",
      "class_name": "OmniMailCleanupWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "omnimail-mail"
      },
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "omnimail-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "omnimail-mail",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "omnimail-mail-dead"
      },
      {
        "queue": "omnimail-notifications",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "omnimail-notifications-dead"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
